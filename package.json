{
  "name": "claude-proxy-manager",
  "version": "0.1.4",
  "description": "Manage claude-proxy launchers on remote development machines over SSH",
  "type": "module",
  "bin": {
    "cpm": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-assets": "node scripts/embed-assets.mjs",
    "build": "npm run embed-assets && tsc -p tsconfig.json",
    "build:release": "sh scripts/build-release.sh release",
    "dev": "tsx src/cli.tsx",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run build && npm test",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
